# --- Optional. The application starts with NONE of the variables below set;
# --- collecting answers needs at least one collection-provider key. ---

# Collection providers (consumer web routes). Each opens chatgpt.com or
# gemini.google.com in a signed-out browser session and returns the page.
# None is licensed by OpenAI or Google. Keys can also be pasted in the
# collection panel; an environment variable wins over a pasted key.
# Bright Data (ChatGPT): API token from the dashboard; free tier 5,000 records a month, no card.
BRIGHTDATA_API_TOKEN=
# cloro (ChatGPT and Gemini): API key from cloro.dev; free tier 500 credits a month, one request at a time.
CLORO_API_KEY=
# Oxylabs (ChatGPT): a Web Scraper API user's username and password joined by a colon; free trial up to 2,000 results, no card, use-case questionnaire first.
OXYLABS_AUTH=
# Decodo (ChatGPT): the Basic-auth token from the dashboard, or user:password; free plan 2,000 standard requests a month (about 670 ChatGPT answers, billed as premium rendered requests). Cannot target a country for ChatGPT.
DECODO_AUTH_TOKEN=
# Engines the product measures. Default "chatgpt" (Gemini hidden for the client demo, 2026-09-15); "chatgpt,gemini" brings Gemini back.
SUN_ENGINES=chatgpt
# Providers to try first, by route id, e.g. chatgpt_brightdata_web to spend free Bright Data records on test runs and keep cloro credits for the demo.
SUN_PREFERRED_ROUTES=
# Country the providers observe from when the project has no market (ISO alpha-2).
SUN_COLLECTION_DEFAULT_COUNTRY=US
# Vendor requests one lane may make per run (30 prompts + canary + retries); keeps a run inside the free tier.
SUN_COLLECTION_MAX_REQUESTS_PER_LANE=60
# cloro concurrent jobs the account allows (1 on the free tier, 10 on the $30 Lite plan). Set 10 after upgrading: a 60-answer run then takes about 7 minutes instead of 35.
SUN_CLORO_CONCURRENCY=1
# Bright Data answers in flight (each takes 5–14 minutes); Oxylabs jobs in flight.
SUN_BRIGHTDATA_CONCURRENCY=5
SUN_OXYLABS_CONCURRENCY=3
# Local stand-ins for the providers (scripts/mock-vendors.ts); leave unset for the real APIs.
# SUN_BRIGHTDATA_BASE_URL=http://localhost:3999/brightdata
# SUN_CLORO_BASE_URL=http://localhost:3999/cloro
# SUN_DECODO_BASE_URL=http://localhost:3999/decodo
# SUN_OXYLABS_BASE_URL=http://localhost:3999/oxylabs

# Optional: Gemini API Free Tier key (https://aistudio.google.com/apikey).
# Used for AI-assisted business-understanding / prompt-candidate generation
# (onboarding stages). No longer a collection lane. Free while billing is off.
GEMINI_API_KEY=

# Optional, PAID: OpenAI API key (https://platform.openai.com/api-keys).
# Used by the Understand and Prompts stages when approved (see CLAUDE.md).
# No longer a collection lane.
OPENAI_API_KEY=

# Local paths and retention. Safe defaults are used if unset.
SUN_DATA_DIR=./data
SUN_EVIDENCE_DIR=./evidence-store
SUN_EVIDENCE_TTL_DAYS=30

# Crawler bounds (defaults shown). Configuration, not product truth.
SUN_CRAWL_MAX_URLS=100
SUN_CRAWL_MAX_PAGES=25
SUN_CRAWL_MAX_DEPTH=2
SUN_CRAWL_TIMEOUT_MS=12000
SUN_CRAWL_MAX_CONTENT_BYTES=2000000

# Set to "true" to allow the Playwright-rendered fallback for the single
# submitted website when static HTML is missing essential content.
SUN_PLAYWRIGHT_FALLBACK_ENABLED=true

# --- Optional: Google Search Console (read-only), see docs/SEARCH_CONSOLE.md ---
# OAuth client of type "Web application" from Google Cloud. Without both, the
# intake switch stays disabled and analysis runs exactly as before.
GOOGLE_OAUTH_CLIENT_ID=
# Also derives the keys that encrypt the stored refresh token and sign the
# OAuth state cookie: rotating it means reconnecting.
GOOGLE_OAUTH_CLIENT_SECRET=
# Exact redirect URI registered in Google Cloud. Optional on localhost, where
# it is derived as http://localhost:<port>/api/integrations/search-console/callback.
GOOGLE_OAUTH_REDIRECT_URI=
# 1 turns the integration off even when the OAuth client is set.
SUN_GSC_DISABLED=
# Days of Search Analytics data to read (7–480).
SUN_GSC_LOOKBACK_DAYS=90
# How long Understand waits for Search Console before continuing without it.
SUN_GSC_WAIT_MS=20000
